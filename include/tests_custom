#!/bin/sh

#
# Test        : CUST-0010

Register --test-no CUST-0010 --weight L --network NO --category custom --description "Get open TCP ports"
if [ ${SKIPTEST} -eq 0 ]; then
    Display --indent 2 --text "- Checking open TCP ports"
    if command -v netstat 1>/dev/null; then
        netstat -tlpn | tail -n +3 | awk '{print $1, $4, $7}' | while IFS='\n' read -r tcp_port; do
            LogText "Open TCP port: ${tcp_port}"
        done

    else
        echo LogText "Result: netstat not found, test skipped"
    fi
fi

